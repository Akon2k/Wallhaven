<Window x:Class="WallhavenExplorer.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallhaven Ultra Explorer .NET 8" Height="750" Width="1100"
        Background="#121212" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding NavigatePreviousCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NavigateNextCommand}"/>
    </Window.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Fila 0: Búsqueda -->
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#333333" Height="35" Padding="5,7,5,5" VerticalContentAlignment="Center" FontSize="14"/>
            <Button Grid.Row="0" Grid.Column="1" Command="{Binding SearchNewQueryCommand}" Content="BUSCAR" Width="120" Margin="10,0,0,0" 
                    Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Grid.Row="0" Grid.Column="2" Command="{Binding OpenSettingsCommand}" Content="AJUSTES" Width="100" Margin="10,0,0,0" 
                    Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            
            <!-- Fila 1: Filtros de Búsqueda -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Text="Categorías:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <CheckBox Content="General" IsChecked="{Binding CategoriesGeneral}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="Anime" IsChecked="{Binding CategoriesAnime}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="People" IsChecked="{Binding CategoriesPeople}" Foreground="White" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Text="Pureza:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <CheckBox Content="SFW" IsChecked="{Binding PuritySfw}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="Sketchy" IsChecked="{Binding PuritySketchy}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="NSFW" IsChecked="{Binding PurityNsfw}" Foreground="White" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Text="Ordenar:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox SelectedValue="{Binding SelectedSorting}" SelectedValuePath="Content" Height="25" Width="120" VerticalAlignment="Center" Margin="0,0,15,0">
                    <ComboBoxItem Content="relevance" IsSelected="True"/>
                    <ComboBoxItem Content="date_added"/>
                    <ComboBoxItem Content="views"/>
                    <ComboBoxItem Content="favorites"/>
                    <ComboBoxItem Content="toplist"/>
                    <ComboBoxItem Content="random"/>
                </ComboBox>

                <ComboBox SelectedValue="{Binding SelectedOrder}" SelectedValuePath="Content" Height="25" Width="80" VerticalAlignment="Center">
                    <ComboBoxItem Content="desc" IsSelected="True"/>
                    <ComboBoxItem Content="asc"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Ajustar a ventana" Click="FitToWindow_Click" Margin="0,0,10,0" Padding="8,4" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Content="Tamaño real" Click="ActualSize_Click" Padding="8,4" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding CopyUrlToClipboardCommand}" Content="📋 Copiar URL" Margin="0,0,10,0" Padding="8,4" Background="#2D2D2D" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Command="{Binding OpenInBrowserCommand}" Content="🌐 Ver en Web" Margin="0,0,10,0" Padding="8,4" Background="#2D2D2D" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        <Button Command="{Binding GetRandomWallpaperCommand}" Content="🎲 Aleatorio" Margin="0,0,10,0" Padding="8,4" Background="#6F42C1" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                        
                        <Button Command="{Binding ToggleSlideshowCommand}" Margin="0,0,10,0" Padding="8,4" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#28A745"/>
                                    <Setter Property="Content" Value="▶ Slideshow"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSlideshowActive}" Value="True">
                                            <Setter Property="Background" Value="#DC3545"/>
                                            <Setter Property="Content" Value="⏸ Detener"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <Button Click="ToggleFullScreen_Click" Content="🖥️ Pantalla Completa" Padding="8,4" Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="4" BorderBrush="#2D2D2D" BorderThickness="1">
                    <Grid>
                        <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MouseWheel="ImageScrollViewer_MouseWheel">
                            <Image Source="{Binding DisplayedImagePath}" Stretch="Uniform" x:Name="WallpaperImage" RenderTransformOrigin="0.5,0.5" Margin="10">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </ScrollViewer>
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" VerticalAlignment="Bottom" Foreground="#007ACC" Background="Transparent" BorderThickness="0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter} , FallbackValue=Collapsed}"/>
                    </Grid>
                </Border>
            </Grid>

            <TabControl SelectedIndex="{Binding SelectedTabIndex}" Grid.Column="1" Margin="15,0,0,0" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <ContentPresenter Content="{TemplateBinding Content}" Margin="10,6" RecognizesAccessKey="True"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Background" Value="#2D2D2D"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </TabControl.Resources>
                
                <!-- Tab 1: Detalle -->
                <TabItem Header="Detalles">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="INFORMACIÓN" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Id, StringFormat='ID: {0}'}" Margin="0,4" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Resolution, StringFormat='Resolución: {0}'}" Margin="0,4" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Category, StringFormat='Categoría: {0}'}" Margin="0,4" Foreground="White"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Uploader, StringFormat='Autor: {0}'}" Margin="0,4" Foreground="White"/>

                            <!-- Botón Favorito -->
                            <Button Command="{Binding ToggleFavoriteCommand}" Margin="0,15,0,0" Height="35" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#D39E00"/>
                                        <Setter Property="Content" Value="★ Añadir a Favoritos"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Background" Value="#C82333"/>
                                                <Setter Property="Content" Value="★ Quitar de Favoritos"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding DownloadOriginalCommand}" Content="Descargar Original" Margin="0,10,0,0" Height="35" Background="#28A745" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                            <!-- Redimensionador Móvil -->
                            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,20,0,0" Background="#121212">
                                <StackPanel>
                                    <TextBlock Text="REDIMENSIONAR MÓVIL" FontSize="12" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>

                                    <TextBlock Text="Resolución:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                    <ComboBox SelectedValue="{Binding SelectedResizeResolution}" SelectedValuePath="Content" Height="25" Margin="0,0,0,10" Background="#2A2A2A" Foreground="White" BorderBrush="#333333">
                                        <ComboBoxItem Content="1080x1920" IsSelected="True"/>
                                        <ComboBoxItem Content="1440x2560"/>
                                        <ComboBoxItem Content="720x1280"/>
                                    </ComboBox>

                                    <TextBlock Text="Modo:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                                    <ComboBox SelectedValue="{Binding SelectedResizeMode}" SelectedValuePath="Content" Height="25" Margin="0,0,0,15" Background="#2A2A2A" Foreground="White" BorderBrush="#333333">
                                        <ComboBoxItem Content="SmartCropCentred" IsSelected="True"/>
                                        <ComboBoxItem Content="LetterboxBlack"/>
                                        <ComboBoxItem Content="ScaleMaintainAspect"/>
                                    </ComboBox>

                                    <Button Command="{Binding CreateMobileVersionCommand}" Content="Crear Versión Móvil" Height="30" Background="#17A2B8" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                
                <!-- Tab 2: Favoritos -->
                <TabItem Header="Favoritos">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="MIS FAVORITOS" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="12,12,12,6"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding FavoriteWallpapers}" SelectedItem="{Binding SelectedWallpaper, Mode=TwoWay}" Background="#121212" Foreground="White" BorderThickness="0" Margin="10,0,10,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8" CornerRadius="2" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontWeight="Bold" Foreground="#007ACC" FontSize="12"/>
                                                <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
                
                <!-- Tab 3: Historial -->
                <TabItem Header="Historial">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="BÚSQUEDAS RECIENTES" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="12,12,12,6"/>
                        <ListBox Grid.Row="1" x:Name="HistoryListBox" ItemsSource="{Binding SearchHistory}" MouseDoubleClick="HistoryListBox_MouseDoubleClick" Background="#121212" Foreground="White" BorderThickness="0" Margin="10,0,10,10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8" CornerRadius="2" Margin="0,2">
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Navegación de Imágenes -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Command="{Binding NavigateFirstCommand}" Content="⏮ Primera" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,5,0"/>
            <Button Command="{Binding NavigatePreviousCommand}" Content="◀ Anterior" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            
            <TextBlock Text="{Binding ImagePositionText}" Foreground="White" VerticalAlignment="Center" Margin="15,0,15,0" FontSize="14" FontWeight="SemiBold"/>

            <Button Command="{Binding NavigateNextCommand}" Content="Siguiente ▶" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Command="{Binding NavigateLastCommand}" Content="Última ⏭" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Paginación de Páginas -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button Command="{Binding GoToPreviousPageCommand}" Content="◀◀ Pág. Anterior" Width="130" Height="30" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            
            <TextBlock Text="{Binding CurrentPage, StringFormat='Página {0}'}" Foreground="White" VerticalAlignment="Center" Margin="15,0,5,0" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MaxPages, StringFormat='de {0}'}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="14"/>

            <Button Command="{Binding GoToNextPageCommand}" Content="Pág. Siguiente ▶▶" Width="130" Height="30" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>

        <StatusBar Grid.Row="4" Background="#1E1E1E" Margin="0,15,0,0" Foreground="#AAAAAA">
            <StatusBar.Style>
                <Style TargetType="StatusBar">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StatusBar.Style>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
