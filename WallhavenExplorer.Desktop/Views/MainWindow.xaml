<Window x:Class="WallhavenExplorer.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallhaven Ultra Explorer Premium .NET 8" Height="780" Width="1200"
        Background="#121214" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding NavigatePreviousCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NavigateNextCommand}"/>
    </Window.InputBindings>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <!-- Columna 0: Barra lateral izquierda de navegación -->
            <ColumnDefinition Width="65">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <!-- Columna 1: Cuerpo principal -->
            <ColumnDefinition Width="*"/>
            <!-- Columna 2: Barra lateral derecha de detalles -->
            <ColumnDefinition Width="320">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDetailsPanelOpen}" Value="False">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                <Setter Property="Width" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Columna 0: Barra lateral de navegación izquierda (Iconos) -->
        <ListBox SelectedIndex="{Binding SelectedTabIndex}" Grid.Column="0" Background="#15151A" BorderThickness="0,0,1,0" BorderBrush="#25252D">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Height" Value="65"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Background="{TemplateBinding Background}">
                                    <Border x:Name="ActiveIndicator" HorizontalAlignment="Left" Width="4" Height="30" Background="#7C4DFF" Visibility="Collapsed" CornerRadius="2"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#202028"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#252535"/>
                                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            
            <!-- Items de navegación -->
            <ListBoxItem ToolTip="Buscar Wallpapers">
                <StackPanel>
                    <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Buscar" FontSize="9.5" Foreground="#AAAAAA" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem ToolTip="Mis Favoritos">
                <StackPanel>
                    <TextBlock Text="⭐" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Favoritos" FontSize="9.5" Foreground="#AAAAAA" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem ToolTip="Historial de Búsquedas">
                <StackPanel>
                    <TextBlock Text="🕒" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Text="Historial" FontSize="9.5" Foreground="#AAAAAA" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!-- Columna 1: Cuerpo principal con control de pestañas invisibles -->
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Tab 0: Búsqueda y Resultados -->
            <TabItem>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <!-- Fila 0: Barra de búsqueda superior y filtros -->
                        <RowDefinition Height="Auto"/>
                        <!-- Fila 1: Grid y Visor (Vista dividida) -->
                        <RowDefinition Height="*"/>
                        <!-- Fila 2: Paginación -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de búsqueda superior y filtros -->
                    <Border Grid.Row="0" Background="#1E1E24" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#2D2D37" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Barra de búsqueda -->
                            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#121214" Foreground="#FFFFFF" BorderBrush="#3D3D4C" BorderThickness="1" Height="36" Padding="10,5" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,10,0">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Row="0" Grid.Column="1" Command="{Binding SearchNewQueryCommand}" Content="Buscar" Width="100" Height="36" Margin="0,0,10,0" 
                                    Background="#7C4DFF" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" Command="{Binding OpenSettingsCommand}" Content="Ajustes ⚙" Width="95" Height="36" 
                                    Background="#2E2E38" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Filtros -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Categorías:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                <CheckBox Content="General" IsChecked="{Binding CategoriesGeneral}" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Anime" IsChecked="{Binding CategoriesAnime}" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox Content="People" IsChecked="{Binding CategoriesPeople}" Foreground="White" Margin="0,0,25,0" VerticalAlignment="Center"/>

                                <TextBlock Text="Pureza:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                <CheckBox Content="SFW" IsChecked="{Binding PuritySfw}" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Sketchy" IsChecked="{Binding PuritySketchy}" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox Content="NSFW" IsChecked="{Binding PurityNsfw}" Foreground="White" Margin="0,0,25,0" VerticalAlignment="Center"/>

                                <TextBlock Text="Ordenar:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="SemiBold"/>
                                <ComboBox SelectedValue="{Binding SelectedSorting}" SelectedValuePath="Content" Height="26" Width="110" VerticalAlignment="Center" Margin="0,0,10,0" Background="#121214" Foreground="White" BorderBrush="#3D3D4C">
                                    <ComboBoxItem Content="relevance" IsSelected="True"/>
                                    <ComboBoxItem Content="date_added"/>
                                    <ComboBoxItem Content="views"/>
                                    <ComboBoxItem Content="favorites"/>
                                    <ComboBoxItem Content="toplist"/>
                                    <ComboBoxItem Content="random"/>
                                </ComboBox>

                                <ComboBox SelectedValue="{Binding SelectedOrder}" SelectedValuePath="Content" Height="26" Width="70" VerticalAlignment="Center" Background="#121214" Foreground="White" BorderBrush="#3D3D4C">
                                    <ComboBoxItem Content="desc" IsSelected="True"/>
                                    <ComboBoxItem Content="asc"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fila 1: Split View (Grilla de Tarjetas a la izquierda, Visor de Imagen a la derecha) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Columna de la grilla (WrapPanel) -->
                            <ColumnDefinition Width="*">
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="*"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGridViewActive}" Value="False">
                                                <Setter Property="Width" Value="0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                                <Setter Property="Width" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            
                            <!-- Columna del Visor Interactivo -->
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Panel de Grilla de Tarjetas -->
                        <Border Grid.Column="0" Background="#1E1E24" CornerRadius="8" BorderBrush="#2D2D37" BorderThickness="1" Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ListBox ItemsSource="{Binding Wallpapers}" SelectedItem="{Binding SelectedWallpaper}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Margin" Value="6"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="CardBorder" Background="#121214" CornerRadius="6" BorderBrush="#2A2A35" BorderThickness="1" ClipToBounds="True">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#7C4DFF"/>
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#1A1A22"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#00B0FF"/>
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#20202F"/>
                                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="135" Height="85" ToolTip="{Binding Resolution}">
                                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Overlay gradiente inferior -->
                                                <Border VerticalAlignment="Bottom" Height="25">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#AA000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <!-- Info Overlay -->
                                                <TextBlock Text="{Binding Resolution}" Foreground="#CCCCCC" FontSize="8.5" FontWeight="Bold" Margin="4" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                                <Border Background="#6F42C1" CornerRadius="2" Padding="3,1" Margin="4" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Category}" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <!-- Visor Interactivo (Derecha/Central) -->
                        <Border Grid.Column="1" Background="#1E1E24" CornerRadius="8" BorderBrush="#2D2D37" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Barra de herramientas superior del Visor -->
                                <Border Grid.Row="0" Background="#18181C" CornerRadius="8,8,0,0" Padding="10,8">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button Content="Ajustar" Click="FitToWindow_Click" Margin="0,0,8,0" Padding="8,4" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Real" Click="ActualSize_Click" Padding="8,4" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Botón de alternancia de grilla -->
                                            <Button Command="{Binding ToggleGridViewCommand}" Margin="0,0,8,0" Padding="8,4" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="🔍 Mostrar Grilla"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGridViewActive}" Value="True">
                                                                <Setter Property="Content" Value="🖥️ Ocultar Grilla"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            
                                            <!-- Botón de alternancia de panel de detalles -->
                                            <Button Command="{Binding ToggleDetailsPanelCommand}" Margin="0,0,8,0" Padding="8,4" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="📋 Mostrar Info"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDetailsPanelOpen}" Value="True">
                                                                <Setter Property="Content" Value="📋 Ocultar Info"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Command="{Binding CopyUrlToClipboardCommand}" Content="📋 Copiar URL" Margin="0,0,8,0" Padding="8,4" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Command="{Binding OpenInBrowserCommand}" Content="🌐 Ver Web" Margin="0,0,8,0" Padding="8,4" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Command="{Binding GetRandomWallpaperCommand}" Content="🎲 Aleatorio" Margin="0,0,8,0" Padding="8,4" Background="#6F42C1" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            
                                            <!-- Slideshow -->
                                            <Button Command="{Binding ToggleSlideshowCommand}" Margin="0,0,8,0" Padding="8,4" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#28A745"/>
                                                        <Setter Property="Content" Value="▶ Slideshow"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSlideshowActive}" Value="True">
                                                                <Setter Property="Background" Value="#DC3545"/>
                                                                <Setter Property="Content" Value="⏸ Detener"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Click="ToggleFullScreen_Click" Content="🖥️ Pantalla Completa" Padding="8,4" Background="#007ACC" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Visualizador de Imagen -->
                                <Border Grid.Row="1" Background="#121214" ClipToBounds="True">
                                    <Grid>
                                        <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MouseWheel="ImageScrollViewer_MouseWheel">
                                            <Image Source="{Binding DisplayedImagePath}" Stretch="Uniform" x:Name="WallpaperImage" RenderTransformOrigin="0.5,0.5" Margin="5">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                        </ScrollViewer>
                                        
                                        <!-- Barra de carga -->
                                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" VerticalAlignment="Bottom" Foreground="#7C4DFF" Background="Transparent" BorderThickness="0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter} , FallbackValue=Collapsed}"/>
                                    </Grid>
                                </Border>

                                <!-- Navegación interna de la imagen -->
                                <Border Grid.Row="2" Background="#18181C" CornerRadius="0,0,8,8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding NavigateFirstCommand}" Content="⏮" Width="40" Height="26" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Margin="0,0,5,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Command="{Binding NavigatePreviousCommand}" Content="◀" Width="40" Height="26" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        
                                        <TextBlock Text="{Binding ImagePositionText}" Foreground="White" VerticalAlignment="Center" Margin="15,0" FontSize="12" FontWeight="SemiBold"/>

                                        <Button Command="{Binding NavigateNextCommand}" Content="▶" Width="40" Height="26" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                        <Button Command="{Binding NavigateLastCommand}" Content="⏭" Width="40" Height="26" Background="#2E2E38" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Margin="5,0,0,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Fila 2: Paginación de Páginas -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Command="{Binding GoToPreviousPageCommand}" Content="◀◀ Pág. Anterior" Width="130" Height="32" Background="#2E2E38" Foreground="White" BorderThickness="0" FontWeight="Bold">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        
                        <TextBlock Text="{Binding CurrentPage, StringFormat='Página {0}'}" Foreground="White" VerticalAlignment="Center" Margin="20,0,5,0" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding MaxPages, StringFormat='de {0}'}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13"/>

                        <Button Command="{Binding GoToNextPageCommand}" Content="Pág. Siguiente ▶▶" Width="130" Height="32" Background="#2E2E38" Foreground="White" BorderThickness="0" FontWeight="Bold">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 1: Favoritos -->
            <TabItem>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="MIS FAVORITOS" FontSize="16" FontWeight="Bold" Foreground="#7C4DFF" Margin="5,0,0,15"/>

                    <Border Grid.Row="1" Background="#1E1E24" CornerRadius="8" BorderBrush="#2D2D37" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding FavoriteWallpapers}" SelectedItem="{Binding SelectedWallpaper}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Margin" Value="8"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="CardBorder" Background="#121214" CornerRadius="6" BorderBrush="#2A2A35" BorderThickness="1" ClipToBounds="True">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#7C4DFF"/>
                                                            <Setter TargetName="CardBorder" Property="Background" Value="#1A1A22"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#00B0FF"/>
                                                            <Setter TargetName="CardBorder" Property="Background" Value="#20202F"/>
                                                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="160" Height="100" ToolTip="{Binding Resolution}">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border VerticalAlignment="Bottom" Height="30">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#AA000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Resolution}" Foreground="#CCCCCC" FontSize="9" FontWeight="Bold" Margin="5" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                                            <Border Background="#6F42C1" CornerRadius="2" Padding="4,2" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Category}" Foreground="White" FontSize="8.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Historial -->
            <TabItem>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="BÚSQUEDAS RECIENTES" FontSize="16" FontWeight="Bold" Foreground="#7C4DFF" Margin="5,0,0,15"/>

                    <Border Grid.Row="1" Background="#1E1E24" CornerRadius="8" BorderBrush="#2D2D37" BorderThickness="1" Padding="10">
                        <ListBox x:Name="HistoryListBox" ItemsSource="{Binding SearchHistory}" MouseDoubleClick="HistoryListBox_MouseDoubleClick" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#121214" CornerRadius="6" BorderBrush="#2A2A35" BorderThickness="1" Padding="15,10">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7C4DFF"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E1E28"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00B0FF"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#202035"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" Margin="0,0,10,0" Foreground="#7C4DFF" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Columna 2: Panel de Detalles Derecho (Colapsable) -->
        <Border Grid.Column="2" Background="#1E1E24" BorderBrush="#2D2D37" BorderThickness="1,0,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="DETALLE DE IMAGEN" FontSize="13" FontWeight="Bold" Foreground="#7C4DFF" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding ToggleDetailsPanelCommand}" HorizontalAlignment="Right" Width="24" Height="24" Background="Transparent" Foreground="#888888" BorderThickness="0" FontWeight="Bold" FontSize="12"/>
                    </Grid>
                    
                    <!-- Tarjeta de Miniatura Principal en Detalles -->
                    <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#33333C" BorderThickness="1" Height="140" Background="#121214" Margin="0,0,0,15">
                        <Grid>
                            <Image Source="{Binding DisplayedImagePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border VerticalAlignment="Bottom" Height="30">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#AA000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Info -->
                    <Border Background="#121214" CornerRadius="6" Padding="12" BorderBrush="#2D2D37" BorderThickness="1" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedWallpaper.Id, StringFormat='ID: {0}'}" Margin="0,3" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Resolution, StringFormat='Resolución: {0}'}" Margin="0,3" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Category, StringFormat='Categoría: {0}'}" Margin="0,3" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedWallpaper.Uploader, StringFormat='Autor: {0}'}" Margin="0,3" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Botón Favorito -->
                    <Button Command="{Binding ToggleFavoriteCommand}" Margin="0,0,0,10" Height="36" Foreground="White" BorderThickness="0" FontWeight="Bold">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#D39E00"/>
                                <Setter Property="Content" Value="⭐ Añadir a Favoritos"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Background" Value="#C82333"/>
                                        <Setter Property="Content" Value="⭐ Quitar de Favoritos"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding DownloadOriginalCommand}" Content="Descargar Original 📥" Margin="0,0,0,20" Height="36" Background="#28A745" Foreground="White" BorderThickness="0" FontWeight="Bold">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- Redimensionador Móvil -->
                    <Border BorderBrush="#2D2D37" BorderThickness="1" CornerRadius="6" Padding="12" Background="#121214">
                        <StackPanel>
                            <TextBlock Text="REDIMENSIONAR MÓVIL" FontSize="11" FontWeight="Bold" Foreground="#7C4DFF" Margin="0,0,0,12"/>

                            <TextBlock Text="Resolución:" FontSize="10" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding SelectedResizeResolution}" SelectedValuePath="Content" Height="26" Margin="0,0,0,12" Background="#2A2A2A" Foreground="White" BorderBrush="#3D3D4C">
                                <ComboBoxItem Content="1080x1920" IsSelected="True"/>
                                <ComboBoxItem Content="1440x2560"/>
                                <ComboBoxItem Content="720x1280"/>
                            </ComboBox>

                            <TextBlock Text="Modo de Ajuste:" FontSize="10" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding SelectedResizeMode}" SelectedValuePath="Content" Height="26" Margin="0,0,0,15" Background="#2A2A2A" Foreground="White" BorderBrush="#3D3D4C">
                                <ComboBoxItem Content="SmartCropCentred" IsSelected="True"/>
                                <ComboBoxItem Content="LetterboxBlack"/>
                                <ComboBoxItem Content="ScaleMaintainAspect"/>
                            </ComboBox>

                            <Button Command="{Binding CreateMobileVersionCommand}" Content="Crear Versión Móvil" Height="32" Background="#17A2B8" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
