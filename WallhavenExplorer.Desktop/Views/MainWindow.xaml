<Window x:Class="WallhavenExplorer.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallhaven Ultra Explorer .NET 8" Height="750" Width="1100"
        Background="#121212" Foreground="#FFFFFF" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    
    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding NavigatePreviousCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NavigateNextCommand}"/>
    </Window.InputBindings>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Fila 0: Búsqueda -->
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                     Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#333333" Height="35" Padding="5,7,5,5" VerticalContentAlignment="Center" FontSize="14"/>
            <Button Grid.Row="0" Grid.Column="1" Command="{Binding SearchNewQueryCommand}" Content="BUSCAR" Width="120" Margin="10,0,0,0" 
                    Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            <Button Grid.Row="0" Grid.Column="2" Command="{Binding OpenSettingsCommand}" Content="AJUSTES" Width="100" Margin="10,0,0,0" 
                    Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            
            <!-- Fila 1: Filtros de Búsqueda -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                <TextBlock Text="Categorías:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <CheckBox Content="General" IsChecked="{Binding CategoriesGeneral}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="Anime" IsChecked="{Binding CategoriesAnime}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="People" IsChecked="{Binding CategoriesPeople}" Foreground="White" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Text="Pureza:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <CheckBox Content="SFW" IsChecked="{Binding PuritySfw}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="Sketchy" IsChecked="{Binding PuritySketchy}" Foreground="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox Content="NSFW" IsChecked="{Binding PurityNsfw}" Foreground="White" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Text="Ordenar:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                <ComboBox SelectedValue="{Binding SelectedSorting}" SelectedValuePath="Content" Height="25" Width="120" VerticalAlignment="Center" Margin="0,0,15,0">
                    <ComboBoxItem Content="relevance" IsSelected="True"/>
                    <ComboBoxItem Content="date_added"/>
                    <ComboBoxItem Content="views"/>
                    <ComboBoxItem Content="favorites"/>
                    <ComboBoxItem Content="toplist"/>
                    <ComboBoxItem Content="random"/>
                </ComboBox>

                <ComboBox SelectedValue="{Binding SelectedOrder}" SelectedValuePath="Content" Height="25" Width="80" VerticalAlignment="Center">
                    <ComboBoxItem Content="desc" IsSelected="True"/>
                    <ComboBoxItem Content="asc"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="Ajustar a ventana" Click="FitToWindow_Click" Margin="0,0,10,0" Padding="8,4" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                    <Button Content="Tamaño real" Click="ActualSize_Click" Padding="8,4" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="4" BorderBrush="#2D2D2D" BorderThickness="1">
                    <Grid>
                        <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MouseWheel="ImageScrollViewer_MouseWheel">
                            <Image Source="{Binding DisplayedImagePath}" Stretch="Uniform" x:Name="WallpaperImage" RenderTransformOrigin="0.5,0.5" Margin="10">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                        </ScrollViewer>
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="4" VerticalAlignment="Bottom" Foreground="#007ACC" Background="Transparent" BorderThickness="0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter} , FallbackValue=Collapsed}"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                <TextBlock Text="INFORMACIÓN" FontSize="16" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SelectedWallpaper.Id, StringFormat='ID: {0}'}" Margin="0,4"/>
                <TextBlock Text="{Binding SelectedWallpaper.Resolution, StringFormat='Resolución: {0}'}" Margin="0,4"/>
                <TextBlock Text="{Binding SelectedWallpaper.Category, StringFormat='Categoría: {0}'}" Margin="0,4"/>
                <TextBlock Text="{Binding SelectedWallpaper.Uploader, StringFormat='Autor: {0}'}" Margin="0,4"/>

                <Button Command="{Binding DownloadOriginalCommand}" Content="Descargar Original" Margin="0,20,0,0" Height="35" Background="#28A745" Foreground="White" BorderThickness="0"/>
                
                <!-- Redimensionador Móvil -->
                <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,15,0,0" Background="#1A1A1A">
                    <StackPanel>
                        <TextBlock Text="REDIMENSIONAR MÓVIL" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Resolución:" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                        <ComboBox SelectedValue="{Binding SelectedResizeResolution}" SelectedValuePath="Content" Height="25" Margin="0,0,0,10">
                            <ComboBoxItem Content="1080x1920" IsSelected="True"/>
                            <ComboBoxItem Content="1440x2560"/>
                            <ComboBoxItem Content="720x1280"/>
                        </ComboBox>

                        <TextBlock Text="Modo:" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,3"/>
                        <ComboBox SelectedValue="{Binding SelectedResizeMode}" SelectedValuePath="Content" Height="25" Margin="0,0,0,15">
                            <ComboBoxItem Content="SmartCropCentred" IsSelected="True"/>
                            <ComboBoxItem Content="LetterboxBlack"/>
                            <ComboBoxItem Content="ScaleMaintainAspect"/>
                        </ComboBox>

                        <Button Command="{Binding CreateMobileVersionCommand}" Content="Crear Versión Móvil" Height="30" Background="#17A2B8" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Paginación -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0" VerticalAlignment="Center">
            <Button Command="{Binding GoToPreviousPageCommand}" Content="◀ Anterior" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            
            <TextBlock Text="{Binding CurrentPage, StringFormat='Página {0}'}" Foreground="White" VerticalAlignment="Center" Margin="15,0,5,0" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding MaxPages, StringFormat='de {0}'}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="14"/>

            <Button Command="{Binding GoToNextPageCommand}" Content="Siguiente ▶" Width="100" Height="30" Background="#333333" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>

        <StatusBar Grid.Row="3" Background="#1E1E1E" Margin="0,15,0,0" Foreground="#AAAAAA">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
